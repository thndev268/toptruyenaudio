# ==========================================
# CENTRALIZED ENVIRONMENT VARIABLES (.env.example)
# Story Platform - Giai đoạn 1 (Website First)
# ==========================================

# ----- BACKEND CONFIGURATION -----
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# MongoDB Atlas / Local MongoDB URI
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/story_platform_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/story_platform_db

# Security & Tokens
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_32chars
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Settings
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Payment & Webhook Secrets (Dùng giả lập hoặc nhà cung cấp thật như SePay/MOMO/VNPAY/Stripe)
PAYMENT_SECRET=your_payment_gateway_api_secret
WEBHOOK_SECRET=your_webhook_signature_verifying_secret

# Object Storage (S3 / Cloud Storage / Cloudinary - Cho ảnh bìa & tệp chứng cứ)
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=story-platform-assets
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# ----- FRONTEND CONFIGURATION -----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME="Truyện Số - Nền Tảng Đọc & Nghe Truyện"
