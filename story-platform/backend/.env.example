# Database
DATABASE_URL="postgresql://user:password@localhost:5432/toptruyenaudio"

# JWT
JWT_SECRET="your-secret-key-here"

# PayOS Configuration
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Frontend URL for payment callbacks
FRONTEND_URL="http://localhost:3000"
RETURN_URL="http://localhost:3000/payment-success"
CANCEL_URL="http://localhost:3000/payment-cancel"

# PayOS direct integration (ưu tiên hơn Gateway middleware)
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# PayOS Gateway middleware (fallback nếu không có credentials trực tiếp)
PAYOS_GATEWAY_URL="https://pay-8dip.onrender.com"

# Port (Render will set this automatically)
PORT=3001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://toptruyenaudio-l298.vercel.app,https://toptruyenaudio.site,https://www.toptruyenaudio.site