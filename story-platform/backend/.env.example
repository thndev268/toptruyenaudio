# Backend Service Config (.env.example)

PORT=3001
API_PREFIX=/api/v1
NODE_ENV=development

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000

# Supabase Auth / PostgreSQL Connection
# Vui lòng copy các key này từ giao diện Supabase (Project Settings -> API & Database)
DATABASE_URL=your_transaction_pooler_url
DIRECT_URL=your_session_url
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# MongoDB Connection (Sắp bị loại bỏ khi migrate hoàn toàn sang Supabase Postgres)
MONGODB_URI=mongodb://localhost:27017/story_platform_db

# Webhook & Payments
PAYMENT_SECRET=your_payment_secret
WEBHOOK_SECRET=your_webhook_secret
