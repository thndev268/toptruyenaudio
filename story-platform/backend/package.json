{
  "name": "story-platform-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS Backend for Story Platform (Supabase PostgreSQL + Prisma + Swagger)",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "bootstrap:owner-admin": "ts-node src/scripts/bootstrap-owner-admin.ts",
    "set-admin-role": "ts-node src/scripts/set-admin-role.ts",
    "list-profiles": "ts-node src/scripts/list-profiles.ts",
    "seed-sample": "ts-node src/scripts/seed-sample-data.ts",
    "seed:dev": "ts-node src/scripts/seed-development.ts",
    "seed:genres": "ts-node src/scripts/seed-genres.ts",
    "seed:premium-plans": "ts-node src/scripts/seed-premium-plans.ts",
    "backfill:chapters": "ts-node src/scripts/backfill-video-chapters.ts",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@payos/node": "^1.0.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/multer": "^2.2.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "mongoose": "^8.7.2",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode.react": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.17.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
